<file path="meatengine/src/systems/hierarchy/update.cpp">
#include <meatengine/SystemRegistry.hpp>
#include <meatengine/MainLoop.hpp>

#include <meatengine/cmp/Transform.hpp>
#include <meatengine/cmp/Parent.hpp>
#include <meatengine/cmp/Children.hpp>
#include <meatengine/cmp/GlobalTransform.hpp>
#include <meatengine/cmp/GlobalBounds.hpp>
#include <meatengine/cmp/Depth.hpp>

#include <meatengine/cmp/ui/ComputedNode.hpp>

#include <functional>
#include <algorithm>

namespace {

using namespace me;
    void walk(
        entt::registry& r,
        entt::entity e,
        const sf::Transform& parent_xf,
        int parent_depth
    ) {
        sf::Transform local;
        if (auto* t = r.try_get<me::cmp::Transform>(e)) {
            local.translate(t->position);
            local.rotate(t->rotation);
            local.scale(t->scale);
        }

        sf::Transform world = parent_xf * local;
        r.get_or_emplace<me::cmp::GlobalTransform>(e).transform = world;
        r.get_or_emplace<me::cmp::Depth>(e).value = parent_depth + 1;

        if (auto* cn = r.try_get<me::cmp::ui::ComputedNode>(e)) {
            auto p0 = world.transformPoint({0.f, 0.f});
            auto p3 = world.transformPoint(cn->size);
            sf::FloatRect aabb{
                {std::min(p0.x, p3.x), std::min(p0.y, p3.y)},
                {std::abs(p3.x - p0.x), std::abs(p3.y - p0.y)}
            };
            r.get_or_emplace<me::cmp::GlobalBounds>(e).rect = aabb;
        }

        if (auto* ch = r.try_get<me::cmp::Children>(e))
            for (auto c : ch->entities)
                if (r.valid(c)) walk(r, c, world, parent_depth + 1);
    }

    void run() {
        auto& r = me::MainLoop::get_registry();
        for (auto [e, _] : r.view<me::cmp::Transform>(entt::exclude<me::cmp::Parent>).each())
            walk(r, e, sf::Transform{}, -1);
    }
}

ME_REGISTER_SYSTEM("engine:hierarchy:update",
   me::SystemPhase::Update,
   3,
   run
)
</file>

<file path="meatengine/src/systems/sprite/render.cpp">
#include <meatengine/SystemRegistry.hpp>
#include <meatengine/MainLoop.hpp>
#include <meatengine/SpriteBatcher.hpp>

#include <meatengine/cmp/ZIndex.hpp>
#include <meatengine/cmp/Sprite.hpp>

#include <algorithm>
#include <vector>

namespace {

using namespace me;

struct RenderEntry {
    sf::Sprite* sprite;
    int z;
};

struct BucketStore {
    std::vector<RenderEntry> flat;
    std::vector<int> zs_unique;
    std::unordered_map<int, std::pair<uint32_t, uint32_t>> z_range; // z -> [begin, end)

    void clear() {
        flat.clear();
        zs_unique.clear();
        z_range.clear();
    }
};

BucketStore& store() { static BucketStore s; return s; }

SpriteBatcher& batcher() { static SpriteBatcher b; return b; }

void sprite_render() {
    auto& reg = MainLoop::get_registry();
    auto& win = MainLoop::get_window();
    auto& st = store();
    auto& bat = batcher();

    st.clear();

    for (auto [e, sprite] : reg.view<cmp::Sprite>().each()) {
        auto* s = sprite.sprite_ptr();
        if (!s) continue;

        int z = 0;
        if (auto* zi = reg.try_get<cmp::ZIndex>(e)) z = zi->value;

        st.flat.push_back({s, z});
    }

    if (st.flat.empty()) return;

    for (auto& e : st.flat) st.zs_unique.push_back(e.z);
    std::sort(st.zs_unique.begin(), st.zs_unique.end());
    st.zs_unique.erase(
        std::unique(st.zs_unique.begin(), st.zs_unique.end()),
        st.zs_unique.end()
    );

    std::unordered_map<int, uint32_t> z_index_of;
    for (size_t i = 0; i < st.zs_unique.size(); ++i)
        z_index_of[st.zs_unique[i]] = static_cast<uint32_t>(i);

    std::vector<uint32_t> counts(st.zs_unique.size(), 0);
    for (auto& e : st.flat) counts[z_index_of[e.z]]++;

    std::vector<uint32_t> offsets(st.zs_unique.size());
    uint32_t total = 0;
    for (size_t i = 0; i < counts.size(); ++i) {
        offsets[i] = total;
        total += counts[i];
    }

    std::vector<RenderEntry> ordered(st.flat.size());
    std::vector<uint32_t> cursor = offsets;
    for (auto& e : st.flat)
        ordered[cursor[z_index_of[e.z]]++] = e;

    bat.begin();
    for (auto& e : ordered) bat.add(*e.sprite);
    bat.flush(win);
}

}

ME_REGISTER_SYSTEM(
    "engine:sprite:render",
    me::SystemPhase::Render,
    std::numeric_limits<int>::min() + 6,
    sprite_render
)
</file>

<file path="meatengine/src/systems/sprite/update.cpp">
#include <meatengine/SystemRegistry.hpp>
#include <meatengine/MainLoop.hpp>

#include <meatengine/cmp/Sprite.hpp>
#include <meatengine/cmp/GlobalTransform.hpp>


namespace me {
    static void update() {
    auto& reg = MainLoop::get_registry();

    for (auto [e, sprite, global] : reg.view<cmp::Sprite, cmp::GlobalTransform>().each()) {
        sf::Sprite* s = sprite.sprite_ptr();
        if (!s) continue;

        if (sprite.center && sprite.offset_dirty) {
            const auto tr = s->getTextureRect();
            sprite.offset = {
                -static_cast<float>(tr.size.x) * 0.5f,
                -static_cast<float>(tr.size.y) * 0.5f
            };
            sprite.offset_dirty = false;
        }

        const sf::Vector2f pos = global.transform.transformPoint(sprite.offset);
        const auto& m = global.transform.getMatrix();
       
        const float sx = std::sqrt(m[0] * m[0] + m[1] * m[1]);
        const float sy = std::sqrt(m[4] * m[4] + m[5] * m[5]);
        const sf::Angle rot = sf::radians(std::atan2(m[1], m[0]));

        s->setPosition(pos);
        s->setRotation(rot);
        s->setScale({sx, sy});
    }
}
}

ME_REGISTER_SYSTEM(
    "engine:sprite:update",
    me::SystemPhase::Update,
    std::numeric_limits<int>::min() + 5,
    me::update
)
</file>

<file path="meatengine/src/systems/ui/process_events.cpp">
#include <meatengine/SystemRegistry.hpp>
#include <meatengine/MainLoop.hpp>
#include <meatengine/ctx/InputState.hpp>

#include <meatengine/cmp/Parent.hpp>
#include <meatengine/cmp/GlobalBounds.hpp>

#include <meatengine/cmp/ui/ComputedNode.hpp>
#include <meatengine/cmp/ui/Interaction.hpp>
#include <meatengine/cmp/ui/FocusPolicy.hpp>
#include <meatengine/cmp/ui/OnEvent.hpp>
#include <meatengine/cmp/ui/States.hpp>

#include <algorithm>
#include <vector>

namespace {

using namespace me;


void sync_state_tags(
    entt::registry& r,
    entt::entity e,
    me::cmp::ui::Interaction state
) {
    using me::cmp::ui::Interaction;

    const bool hovered = (state == Interaction::Hovered || state == Interaction::Pressed);
    const bool pressed = (state == Interaction::Pressed);

    if (hovered) r.emplace_or_replace<me::cmp::ui::Hovered>(e);
    else r.remove<me::cmp::ui::Hovered>(e);

    if (pressed) r.emplace_or_replace<me::cmp::ui::Pressed>(e);
    else r.remove<me::cmp::ui::Pressed>(e);
}

void bubble_event(entt::registry& r, entt::entity e, me::cmp::ui::Event& ev) {
    while (e != entt::null && r.valid(e)) {
        if (auto* h = r.try_get<me::cmp::ui::OnEvent>(e)) {
            h->cb(r, e, ev);
            if (ev.handled) return;
        }
        auto* p = r.try_get<me::cmp::Parent>(e);
        e = (p && p->entity != entt::null && r.valid(p->entity)) ? p->entity : entt::null;
    }
}

entt::entity pick_topmost(entt::registry& r, sf::Vector2f world_pos) {
    entt::entity best = entt::null;
    uint32_t best_stack = 0;

    for (auto [e, gb] : r.view<me::cmp::GlobalBounds>().each()) {
        if (!gb.rect.contains(world_pos)) continue;

        auto* cn = r.try_get<me::cmp::ui::ComputedNode>(e);
        uint32_t stack = cn ? cn->stack_index : 0u;

        const bool interactive = r.any_of<me::cmp::ui::Interaction>(e);
        if (!interactive) continue;

        if (best == entt::null || stack >= best_stack) {
            best = e;
            best_stack = stack;
        }
    }
    return best;
}

void run() {
    auto& r = me::MainLoop::get_registry();
    auto& in = r.ctx().get<me::ctx::InputState>();

    using me::cmp::ui::Interaction;
    using me::cmp::ui::Event;
    using me::cmp::ui::EventType;

    entt::entity target = pick_topmost(r, in.mouse_pos);

    while (target != entt::null) {
        auto* fp = r.try_get<me::cmp::ui::FocusPolicy>(target);
        if (fp && fp->kind == me::cmp::ui::FocusPolicy::Kind::None) {
            auto* p = r.try_get<me::cmp::Parent>(target);
            target = (p && r.valid(p->entity)) ? p->entity : entt::null;
            continue;
        }
        break;
    }

    static entt::entity prev_hover = entt::null;

    if (target != prev_hover) {
        if (prev_hover != entt::null && r.valid(prev_hover)) {
            Event ev{EventType::Unhover, in.mouse_pos, prev_hover, false};
            bubble_event(r, prev_hover, ev);

            if (auto* i = r.try_get<Interaction>(prev_hover))
                *i = Interaction::None;
            sync_state_tags(r, prev_hover, Interaction::None);
        }
        if (target != entt::null) {
            Event ev{EventType::Hover, in.mouse_pos, target, false};
            bubble_event(r, target, ev);
        }
        prev_hover = target;
    }

    if (target != entt::null) {
        if (auto* i = r.try_get<Interaction>(target)) {
            if (in.mouse_down)
                *i = Interaction::Pressed;
            else
                *i = Interaction::Hovered;
        }
        sync_state_tags(r, target,
            in.mouse_down ? Interaction::Pressed : Interaction::Hovered);
    }

    static entt::entity press_target = entt::null;

    if (in.mouse_just_pressed && target != entt::null) {
        press_target = target;
        Event ev{EventType::Press, in.mouse_pos, target, false};
        bubble_event(r, target, ev);
    }

    if (in.mouse_just_released) {
        if (press_target != entt::null && press_target == target) {
            Event ev{EventType::Click, in.mouse_pos, target, false};
            bubble_event(r, target, ev);
        }
        if (press_target != entt::null && r.valid(press_target)) {
            Event ev{EventType::Release, in.mouse_pos, press_target, false};
            bubble_event(r, press_target, ev);
        }
        press_target = entt::null;
    }
}

}

ME_REGISTER_SYSTEM("engine:ui:process_events",
    me::SystemPhase::Input,
    10,
    run
)
