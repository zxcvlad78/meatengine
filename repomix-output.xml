    table.set_function("get_window_title",
        []() -> std::string {
            return me::MainLoop::get_window_title();
        });

    table.set_function("set_window_title",
        [](const std::string& s) -> void {
            me::MainLoop::set_window_title(s);
        });

    table.set_function("get_framerate_limit",
